{
  "name": "waveframe",
  "version": "0.3.1",
  "description": "A high-performance, customizable React audio player with SoundCloud-style waveforms and built-in audio analysis.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://gradippp.github.io/waveframe",
  "bugs": {
    "url": "https://github.com/gradippp/waveframe/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:lib && pnpm run build:app",
    "build:lib": "tsup && node scripts/prepend-use-client.js",
    "build:app": "tsc && cross-env BUILD_MODE=app vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "docs": "typedoc src/index.ts"
  },
  "keywords": [
    "react",
    "audio-player",
    "waveform",
    "soundcloud-style",
    "audio-visualizer",
    "web-audio-api",
    "component-library",
    "typescript",
    "tailwind-css"
  ],
  "author": "Agradip <me@agradip.fyi>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gradippp/waveframe.git"
  },
  "packageManager": "pnpm@10.26.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "tsc-alias": "^1.8.17",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typedoc-material-theme": "^1.4.1",
    "typedoc-plugin-extras": "^4.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
